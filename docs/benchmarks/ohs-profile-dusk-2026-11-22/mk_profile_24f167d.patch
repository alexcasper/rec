+// returns record count (capped at max); wall-clock rate in kHz in *khz
+extern "C" int mk_prof_read(int* line, uint64_t* ta, uint64_t* tr, int max, int* khz) {
+    uint32_t n = 0;
+    hipMemcpyFromSymbol(&n, HIP_SYMBOL(g_prof_n), sizeof(n));
+    int m = (int)(n < (uint32_t)max ? n : (uint32_t)max);
+    if (m > (int)MK_PROF_MAX) m = (int)MK_PROF_MAX;
+    hipMemcpyFromSymbol(line, HIP_SYMBOL(g_prof_line), m * sizeof(int));
+    hipMemcpyFromSymbol(ta, HIP_SYMBOL(g_prof_ta), m * sizeof(uint64_t));
+    hipMemcpyFromSymbol(tr, HIP_SYMBOL(g_prof_tr), m * sizeof(uint64_t));
+    hipDeviceGetAttribute(khz, hipDeviceAttributeWallClockRate, 0);
+    return (int)n;
+}
